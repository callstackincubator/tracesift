{
  "name": "@callstack/tracesift-explore",
  "version": "0.6.0",
  "description": "TraceSift's profile drill-down views: task timeline, flame graph, call tree, React commits",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/explore.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "npm run build:js && npm run build:css",
    "build:js": "tsc -p tsconfig.build.json",
    "build:css": "tailwindcss -i src/styles/tailwind.css -o dist/explore.css --minify",
    "prepare": "npm run build",
    "prepack": "npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "@rozenite/ui": ">=2.4.0",
    "react": ">=19",
    "react-dom": ">=19"
  },
  "devDependencies": {
    "@rozenite/ui": "^2.4.0",
    "@tailwindcss/cli": "^4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": "https://github.com/callstackincubator/tracesift.git"
}
